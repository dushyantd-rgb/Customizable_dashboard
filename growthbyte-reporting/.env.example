# GrowthByte Reporting Platform
# Copy to .env for local development. Keep real credentials out of Git.

# Application
APP_NAME=growthbyte-reporting
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Local service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
MCP_URL=http://localhost:8001/mcp
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Reporting Supabase (backend-only in Phase 2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:54322/postgres

# Existing knowledge Supabase (read-only discovery only; no Phase 2 runtime connection)
SUPABASE_KNOWLEDGE_BASE_URL=https://your-knowledge-project.supabase.co

# Google Sheets OAuth (backend-only; connector work is outside this phase)
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Meta (backend-only; integration work is outside this phase)
META_ACCESS_TOKEN=replace-with-meta-access-token

# GLM gateway (backend-only; agent work is outside this phase)
GLM_API_KEY=replace-with-glm-gateway-key

# MCP transport
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
