# GrowthByte Reporting Platform
# Copy to .env for local development. Keep real credentials out of Git.

# Application
APP_NAME=growthbyte-reporting
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Local service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
MCP_URL=http://localhost:8001/mcp
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Reporting Supabase (backend-only; unused during Phase 1)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:54322/postgres

# Existing knowledge Supabase (backend-only; approved read-only inspection only)
# Do not connect this database to the Phase 1 runtime or copy its data.
KNOWLEDGE_SUPABASE_URL=https://your-knowledge-project.supabase.co
KNOWLEDGE_SUPABASE_READ_ONLY_KEY=replace-with-read-only-knowledge-supabase-key

# Google Sheets OAuth (backend-only; unused during Phase 1)
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Meta (backend-only; unused during Phase 1)
META_ACCESS_TOKEN=replace-with-meta-access-token

# GLM gateway (backend-only; unused during Phase 1)
GLM_API_KEY=replace-with-glm-gateway-key

# MCP transport
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
