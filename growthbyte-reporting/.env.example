# GrowthByte Reporting Platform
# Copy to .env for local development. Keep real credentials out of Git.

# Application
APP_NAME=growthbyte-reporting
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Local service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000
MCP_URL=http://localhost:8001/mcp
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Reporting Supabase (backend-only in Phase 2)
REPORTING_SUPABASE_URL=https://your-reporting-project.supabase.co
REPORTING_SUPABASE_SERVICE_ROLE_KEY=replace-with-reporting-service-role-key
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:54322/postgres

# Existing knowledge Supabase (strictly read-only source)
SUPABASE_KNOWLEDGE_BASE_URL=https://your-knowledge-project.supabase.co
SUPABASE_KNOWLEDGE_BASE_SERVICE_ROLE_KEY=replace-with-knowledge-service-role-key

# Google OAuth (backend-only; Sheets and Search Console)
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# SuperK Franchise prototype (backend-only identifiers)
SUPERK_CLIENT_ID=replace-with-superk-client-uuid
SUPERK_FRANCHISE_META_ACCOUNT_ID=replace-with-franchise-meta-account-id
SUPERK_GSC_SITE_URL=replace-with-approved-search-console-property
# Optional override; defaults to superk_purchase_qcom.json in the repository root.
SUPERK_LEAD_JSON_PATH=replace-with-absolute-lead-json-path

# Meta (backend-only)
META_ACCESS_TOKEN=replace-with-meta-access-token
# Primary client-scoped Meta Ads tokens.
SILPA_ACCESS_TOKEN=replace-with-silpa-meta-access-token
SUPERK_ACCESS_TOKEN=replace-with-superk-meta-access-token
# Backward-compatible client token names used only when the primary token is absent.
SUPERK_META_ACCESS_TOKEN=replace-with-superk-marketing-api-token
FRANCHISE_META_ACCESS_TOKEN=replace-with-franchise-marketing-api-token
# Existing page tokens are kept separate and cannot normally enumerate ad accounts.
SUPERK_PAGE_ACCESS_TOKEN=replace-with-superk-page-access-token
FRANCHISE_PAGE_ACCESS_TOKEN=replace-with-franchise-page-access-token
META_GRAPH_API_VERSION=v19.0

# Token encryption (backend-only)
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-encryption-key

# Anthropic-compatible GLM gateway (backend-only)
ANTHROPIC_BASE_URL=https://replace-with-glm-gateway.example
ANTHROPIC_AUTH_TOKEN=replace-with-glm-gateway-token
ANTHROPIC_DEFAULT_OPUS_MODEL=replace-with-opus-model
ANTHROPIC_DEFAULT_SONNET_MODEL=replace-with-sonnet-model
ANTHROPIC_DEFAULT_HAIKU_MODEL=replace-with-haiku-model

# MCP transport
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_SERVER_URL=http://localhost:8001/mcp

# Approved-report export storage
REPORT_STORAGE_BUCKET=replace-with-private-report-storage-bucket
